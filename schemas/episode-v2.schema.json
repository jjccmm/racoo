{
  "$defs": {
    "Audio": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "required": [
        "url",
        "duration_seconds"
      ],
      "title": "Audio",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "start_seconds",
        "end_seconds"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rss",
            "supplemental",
            "synthetic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "reference_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Reference Url",
          "type": "string"
        },
        "guid": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guid"
        },
        "guid_aliases": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Guid Aliases",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "key",
        "reference_url"
      ],
      "title": "Source",
      "type": "object"
    },
    "Timings": {
      "additionalProperties": false,
      "properties": {
        "download_seconds": {
          "minimum": 0,
          "title": "Download Seconds",
          "type": "number"
        },
        "transcription_seconds": {
          "minimum": 0,
          "title": "Transcription Seconds",
          "type": "number"
        },
        "total_seconds": {
          "minimum": 0,
          "title": "Total Seconds",
          "type": "number"
        }
      },
      "required": [
        "download_seconds",
        "transcription_seconds",
        "total_seconds"
      ],
      "title": "Timings",
      "type": "object"
    },
    "Transcription": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Revision",
          "type": "string"
        },
        "export_revision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Export Revision",
          "type": "string"
        },
        "processed_at": {
          "format": "date-time",
          "title": "Processed At",
          "type": "string"
        },
        "runtime_versions": {
          "minProperties": 1,
          "patternProperties": {
            "\\S": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Runtime Versions",
          "type": "object"
        },
        "export_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Export Id"
        },
        "execution_providers": {
          "patternProperties": {
            "\\S": {
              "items": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Execution Providers",
          "type": "object"
        },
        "configuration": {
          "patternProperties": {
            "\\S": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Configuration",
          "type": "object"
        },
        "configuration_revision": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Revision"
        },
        "transcript_revision": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Revision"
        }
      },
      "required": [
        "model_id",
        "model_revision",
        "export_revision",
        "processed_at",
        "runtime_versions"
      ],
      "title": "Transcription",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "podcast_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$",
      "title": "Podcast Id",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "title": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "episode_number": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Number"
    },
    "webpage_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Webpage Url"
    },
    "audio": {
      "$ref": "#/$defs/Audio"
    },
    "timings": {
      "$ref": "#/$defs/Timings"
    },
    "transcription": {
      "$ref": "#/$defs/Transcription"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "podcast_id",
    "episode_id",
    "source",
    "title",
    "published_at",
    "audio",
    "timings",
    "transcription",
    "segments"
  ],
  "title": "Episode",
  "type": "object"
}
